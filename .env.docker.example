# Copy to .env.docker and fill in. Never commit the filled-in file.

# Hostname Caddy serves. A real hostname gets an automatic HTTPS certificate; ":80" is plain HTTP.
SITE_ADDRESS=:80
# Set to 0 when SITE_ADDRESS is ":80" (plain HTTP), otherwise admin login cookies are HTTPS-only.
BEHIND_PROXY=0

# Generate each of these with:  openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: AI reports and the Google basemap. The map falls back to OpenStreetMap without a Google key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MAPS_API_KEY=
